# ===========================================================================
# E-commerce Data Lakehouse - Environment Variables Template
# Copy this file to .env and fill in the values. NEVER commit .env to git!
# ===========================================================================

# 1. MinIO Object Storage
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
MINIO_ENDPOINT=http://minio:9000

# 2. Hive Metastore Database (PostgreSQL 13.15)
HMS_DB_USER=hive
HMS_DB_PASSWORD=CHANGE_ME_HMS_DB_PASSWORD
HMS_DB_NAME=metastore

# 3. Airflow Metadata Database (PostgreSQL 14.12)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_AIRFLOW_DB_PASSWORD
AIRFLOW_DB_NAME=airflow

# 4. Apache Airflow Service
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
AIRFLOW_ADMIN_FIRSTNAME=Minh
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=minh.lead@lakehouse.local
# Sinh khóa Fernet bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET_KEY
AIRFLOW_SECRET_KEY=CHANGE_ME_AIRFLOW_SECRET_KEY

# 5. Dremio OSS
DREMIO_ADMIN_USER=admin
DREMIO_ADMIN_PASSWORD=CHANGE_ME_DREMIO_PASSWORD
DREMIO_HOST=dremio
DREMIO_FLIGHT_PORT=32010
DREMIO_CATALOG=hive
DREMIO_GOLD_SCHEMA=gold

# 6. Google Gemini API (Serving / Executive Summary)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
