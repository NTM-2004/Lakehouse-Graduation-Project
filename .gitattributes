# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files that must always use LF line endings
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env* text eol=lf

# Denote binary files that should not be modified by Git
*.jar binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
